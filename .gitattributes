# Force LF line endings for source files
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf

# Binary files — do not diff
*.h5 binary
*.parquet binary
*.mp4 binary
*.avi binary
*.pkl binary
*.png binary
*.jpg binary
*.jpeg binary
*.ipynb text eol=lf
